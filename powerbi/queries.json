{
  "goals": {
    "base_table": "GoalPlay",
    "selected_cols": [
      "GoalPlay.player_id"
    ],
    "joins": [
      {
        "table": "Play", 
        "conn": "GoalPlay.play_id == Play.id", 
        "type": "left"
      },
      {
        "table": "Match", 
        "conn": "Play.match_id == Match.id", 
        "type": "left"
      },
      {
        "table": "Season", 
        "conn": "Match.season_id == Season.id", 
        "type": "left"
      },
      {
        "table": "Player", 
        "conn": "Player.id == GoalPlay.player_id", 
        "type": "left"
      }

    ]
  },
  "assists": {
    "base_table": "AssistPlay",
    "selected_cols": [
      "AssistPlay.player_id",
      "AssistPlay.is_primary"
    ],
    "joins": [
      {
        "table": "GoalPlay", 
        "conn": "AssistPlay.goal_id == GoalPlay.id", 
        "type": "left"
      },
      {
        "table": "Play", 
        "conn": "GoalPlay.play_id == Play.id", 
        "type": "left"
      },
      {
        "table": "Match", 
        "conn": "Play.match_id == Match.id", 
        "type": "left"
      },
      {
        "table": "Season", 
        "conn": "Match.season_id == Season.id", 
        "type": "left"
      },
      {
        "table": "Player", 
        "conn": "Player.id == AssistPlay.player_id", 
        "type": "left"
      }

    ]
  },
  "shifts": {
    "base_table": "PlayerShift",
    "selected_cols": [
      "PlayerShift.player_id",
      "PlayerShift.shift_start",
      "PlayerShift.shift_end"
    ],
    "joins": [
      {
        "table": "Match", 
        "conn": "PlayerShift.match_id == Match.id", 
        "type": "left"
      }
    ]
  },
  "player_basic_info": {
    "base_table": "Player",
    "selected_cols": [
      "Player.id",
      "Player.name",
      "Player.position",
      "Place.country_s"
    ],
    "joins": [
      {
        "table": "Place", 
        "conn": "Player.place_birth_id == Place.id", 
        "type": "left"
      }

    ]

  }
}